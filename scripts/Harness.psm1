function Invoke-HarnessNative {
    <#
    .SYNOPSIS
        Runs a command-line tool and returns its exit code and output.
    .DESCRIPTION
        Standard input is closed, so the tool cannot wait for a person, and
        standard error is kept apart from the output. A non-zero exit fails
        with the command line, the exit code and the tool's own words, unless
        -Tolerant is given. A tool that runs past the timeout is stopped.
    .PARAMETER Command
        The tool's name, such as git or claude.
    .PARAMETER ArgumentList
        The arguments, one element each.
    .PARAMETER Environment
        Variables to set for this run only; a $null value removes one.
    .PARAMETER WorkingDirectory
        The folder to run in. Defaults to the current location.
    .PARAMETER TimeoutSeconds
        How long the tool may run. Defaults to 120.
    .PARAMETER Display
        The command line to show in messages, when the real one must be
        hidden.
    .PARAMETER HideOutput
        Leaves the tool's output out of a failure message.
    .PARAMETER WhatIf
        Shows what would happen if the command runs. The command is not run.
    .PARAMETER Confirm
        Prompts for confirmation before the command runs.
    .INPUTS
        None.
    .OUTPUTS
        System.Management.Automation.PSCustomObject. ExitCode, Output (the
        lines of standard output) and Error (standard error).
    .EXAMPLE
        Invoke-HarnessNative -Command git -ArgumentList @('rev-parse', 'HEAD')

        Returns the current commit in Output.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding(SupportsShouldProcess)]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory)]
        [ValidatePattern('^(?!-)', ErrorMessage = 'The command name must not start with a dash.')]
        [string]$Command,

        [AllowEmptyCollection()]
        [string[]]$ArgumentList = @(),

        [hashtable]$Environment = @{},

        [string]$WorkingDirectory,

        [ValidateRange(1, 3600)]
        [int]$TimeoutSeconds = 120,

        [string]$Display,

        [switch]$HideOutput
    )

    try {
        $ErrorActionPreference = 'Stop'

        $shown = if ($Display) { $Display } else { (@($Command) + $ArgumentList) -join ' ' }
        $resolved = Resolve-HarnessCommand -Name $Command
        if ($null -eq $resolved) {
            throw "Running $shown failed: $Command was not found on PATH."
        }

        if ($resolved.CommandType -eq 'Application' -and
            [IO.Path]::GetExtension($resolved.Source) -in '.cmd', '.bat') {
            # cmd.exe re-parses a .cmd/.bat shim's arguments, which can inject options from a manifest value.
            throw "Running $shown failed: $Command resolves to a .cmd or .bat shim ($($resolved.Source)); " +
                'install the native claude executable so its arguments are passed without a cmd.exe re-parse.'
        }

        if (-not $PSCmdlet.ShouldProcess($shown, 'Run')) {
            return
        }

        $fileName = $resolved.Source
        $arguments = [List[string]]::new()
        if ($resolved.CommandType -eq 'ExternalScript') {
            $arguments.AddRange([string[]]@('-NoProfile', '-NonInteractive', '-File', $fileName))
            $fileName = [Environment]::ProcessPath
        }

        $arguments.AddRange($ArgumentList)
        $info = [Diagnostics.ProcessStartInfo]::new($fileName)
        foreach ($argument in $arguments) {
            $info.ArgumentList.Add($argument)
        }

        $info.UseShellExecute = $false
        $info.CreateNoWindow = $true
        $info.RedirectStandardInput = $true
        $info.RedirectStandardOutput = $true
        $info.RedirectStandardError = $true
        $info.StandardOutputEncoding = [Text.UTF8Encoding]::new($false)
        $info.StandardErrorEncoding = [Text.UTF8Encoding]::new($false)
        $info.WorkingDirectory = if ($WorkingDirectory) { $WorkingDirectory } else { (Get-Location).ProviderPath }
        foreach ($entry in $Environment.GetEnumerator()) {
            if ($null -eq $entry.Value) {
                $null = $info.Environment.Remove($entry.Key)
            }
            else {
                $info.Environment[$entry.Key] = [string]$entry.Value
            }
        }

        $process = [Diagnostics.Process]::Start($info)
        try {
            $process.StandardInput.Close()
            $stdout = $process.StandardOutput.ReadToEndAsync()
            $stderr = $process.StandardError.ReadToEndAsync()
            if (-not $process.WaitForExit($TimeoutSeconds * 1000)) {
                $process.Kill($true)
                throw [TimeoutException]::new("Running $shown failed: it ran past $TimeoutSeconds seconds.")
            }

            $process.WaitForExit()
            $output = $stdout.GetAwaiter().GetResult().TrimEnd()
            $errorText = $stderr.GetAwaiter().GetResult().Trim()
            $exitCode = $process.ExitCode
        }
        finally {
            $process.Dispose()
        }

        $lines = [string[]]@()
        if ($output.Length -gt 0) {
            $lines = [string[]]($output -split '\r?\n')
        }

        if ($exitCode -ne 0) {
            $detail = if ($HideOutput) {
                'the output is hidden because it may echo configuration'
            }
            else {
                $words = if ($errorText) { $errorText -split '\r?\n' } else { $lines }
                $said = @($words | Where-Object { $_ -match '\S' -and $_ -notmatch '^hint:' })
                ($said | Select-Object -Last 5) -join ' / '
            }

            throw "Running $shown failed with exit code ${exitCode}: $detail"
        }

        return [PSCustomObject]@{
            ExitCode = $exitCode
            Output   = $lines
            Error    = $errorText
        }
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

