function Get-HarnessClaudeEnvironment {
    <#
    .SYNOPSIS
        Returns the environment the Claude Code CLI needs for a home path.
    .DESCRIPTION
        For the real home directory nothing is set, so the CLI uses its usual
        configuration. For any other home path CLAUDE_CONFIG_DIR is pointed
        at <home>/.claude, so a trial install never reaches the real one.
    .PARAMETER HomePath
        The home directory being installed into.
    .INPUTS
        None.
    .OUTPUTS
        System.Collections.Hashtable. Variables for Invoke-HarnessNative.
    .EXAMPLE
        Get-HarnessClaudeEnvironment -HomePath /tmp/home

        Returns CLAUDE_CONFIG_DIR set to /tmp/home/.claude.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([hashtable])]
    param(
        [Parameter(Mandatory)]
        [string]$HomePath
    )

    try {
        $ErrorActionPreference = 'Stop'

        if (Test-HarnessSamePath -Left $HomePath -Right $HOME) {
            return @{}
        }

        return @{ CLAUDE_CONFIG_DIR = (Join-Path $HomePath '.claude') }
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Get-HarnessClaudeInventory {
    <#
    .SYNOPSIS
        Returns the marketplaces, plugins and MCP servers Claude Code has.
    .DESCRIPTION
        Marketplaces and plugins come from the CLI's --json lists. MCP server
        names come from the user configuration file directly, because
        "claude mcp list" connects to every server to check its health. Only
        names are read; no server configuration is returned.
    .PARAMETER HomePath
        The home directory being installed into.
    .INPUTS
        None.
    .OUTPUTS
        System.Management.Automation.PSCustomObject. Environment,
        WorkingDirectory, Marketplaces, Plugins (Id and Scope) and McpServers.
    .EXAMPLE
        Get-HarnessClaudeInventory -HomePath $HOME

        Returns what is installed for the current user.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory)]
        [string]$HomePath
    )

    try {
        $ErrorActionPreference = 'Stop'

        $environment = Get-HarnessClaudeEnvironment -HomePath $HomePath
        $run = @{
            Command          = 'claude'
            Environment      = $environment
            WorkingDirectory = $HomePath
            WhatIf           = $false
            Confirm          = $false
        }

        $listed = Invoke-HarnessNative @run -ArgumentList @('plugin', 'marketplace', 'list', '--json')
        $marketplaces = @(ConvertFrom-HarnessJsonText -Text ($listed.Output -join "`n")) |
            ForEach-Object { [string]$_['name'] }

        $listed = Invoke-HarnessNative @run -ArgumentList @('plugin', 'list', '--json')
        $plugins = @(ConvertFrom-HarnessJsonText -Text ($listed.Output -join "`n")) | ForEach-Object {
            [PSCustomObject]@{
                Id    = [string]$_['id']
                Scope = [string]$_['scope']
            }
        }

        $configDir = if ($environment.ContainsKey('CLAUDE_CONFIG_DIR')) {
            $environment['CLAUDE_CONFIG_DIR']
        }
        else {
            $env:CLAUDE_CONFIG_DIR
        }

        $configFile = if ($configDir) {
            Join-Path $configDir '.claude.json'
        }
        else {
            Join-Path $HomePath '.claude.json'
        }

        $servers = @()
        if ([IO.File]::Exists($configFile)) {
            # .claude.json holds the CLI's whole config; read only the mcpServers names, without
            # materialising the rest as PowerShell objects.
            $configText = Read-HarnessText -Path $configFile
            $document = [System.Text.Json.JsonDocument]::Parse($configText, (New-HarnessJsonOption))
            try {
                $element = [System.Text.Json.JsonElement]::new()
                $root = $document.RootElement
                $hasServers = $root.ValueKind -eq 'Object' -and $root.TryGetProperty('mcpServers', [ref]$element)
                if ($hasServers -and $element.ValueKind -eq 'Object') {
                    $servers = @($element.EnumerateObject() | ForEach-Object { $_.Name })
                }
            }
            finally {
                $document.Dispose()
            }
        }

        return [PSCustomObject]@{
            Environment      = $environment
            WorkingDirectory = $HomePath
            Marketplaces     = @($marketplaces)
            Plugins          = @($plugins)
            McpServers       = $servers
        }
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Read-HarnessPluginManifest {
    <#
    .SYNOPSIS
        Returns the checked content of claude/plugins.json.
    .DESCRIPTION
        Fails with a message naming the entry when a required field is missing
        or has the wrong type, or when a key is not one the manifest knows;
        keys are case-sensitive.
    .PARAMETER Path
        The full path of the plugin manifest.
    .INPUTS
        None.
    .OUTPUTS
        System.Management.Automation.PSCustomObject. Marketplaces (Name,
        Source, Ref) and Plugins (Name, Marketplace, Scope, Id).
    .EXAMPLE
        Read-HarnessPluginManifest -Path /home/me/ai-harness/claude/plugins.json

        Returns the marketplaces and plugins to install.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory)]
        [string]$Path
    )

    try {
        $ErrorActionPreference = 'Stop'

        $data = Read-HarnessJson -Path $Path
        Assert-HarnessObject -Value $data -Where $Path
        Assert-HarnessKey -Entry $data -Allowed 'Marketplaces', 'Plugins' -Where $Path

        $refPattern = '^[A-Za-z0-9][A-Za-z0-9._/-]*$'
        $entries = @(Get-HarnessManifestList -Entry $data -Name 'Marketplaces' -Where $Path)
        $marketplaces = for ($i = 0; $i -lt $entries.Count; $i++) {
            $field = @{
                Entry = $entries[$i]
                Where = "$Path Marketplaces[$i]"
            }
            Assert-HarnessObject -Value $field.Entry -Where $field.Where
            Assert-HarnessKey @field -Allowed 'Name', 'Source', 'Ref'
            $source = Get-HarnessManifestString @field -Name 'Source' -Pattern '\S'
            if ($source -cnotmatch $script:SourcePattern -and -not (Test-Path -LiteralPath $source)) {
                throw "$($field.Where) has an invalid `"Source`": it must be owner/repo (with an optional " +
                    '#ref or @ref), an https URL, or an existing local path.'
            }

            [PSCustomObject]@{
                Name   = Get-HarnessManifestString @field -Name 'Name' -Pattern $script:NamePattern
                Source = $source
                Ref    = Get-HarnessManifestString @field -Name 'Ref' -Pattern $refPattern -Optional
            }
        }

        $entries = @(Get-HarnessManifestList -Entry $data -Name 'Plugins' -Where $Path)
        $plugins = for ($i = 0; $i -lt $entries.Count; $i++) {
            $field = @{
                Entry = $entries[$i]
                Where = "$Path Plugins[$i]"
            }
            Assert-HarnessObject -Value $field.Entry -Where $field.Where
            Assert-HarnessKey @field -Allowed 'Name', 'Marketplace', 'Scope'
            $name = Get-HarnessManifestString @field -Name 'Name' -Pattern $script:NamePattern
            $marketplace = Get-HarnessManifestString @field -Name 'Marketplace' -Pattern $script:NamePattern
            $scope = Get-HarnessManifestString @field -Name 'Scope' -Pattern '^(user|project|local)$' -Optional
            [PSCustomObject]@{
                Name        = $name
                Marketplace = $marketplace
                Scope       = if ($scope) { $scope } else { 'user' }
                Id          = "$name@$marketplace"
            }
        }

        return [PSCustomObject]@{
            Marketplaces = @($marketplaces)
            Plugins      = @($plugins)
        }
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Get-HarnessPluginSetting {
    <#
    .SYNOPSIS
        Returns the user settings that keep the manifest's plugins enabled.
    .DESCRIPTION
        Claude Code records an installed plugin in enabledPlugins and an added
        marketplace in extraKnownMarketplaces, inside ~/.claude/settings.json.
        That file is generated, so the installer writes both keys itself from
        claude/plugins.json; otherwise every reinstall would drop them and
        disable the plugins. Only user-scope plugins are included.
    .PARAMETER PluginManifest
        The result of Read-HarnessPluginManifest.
    .INPUTS
        None.
    .OUTPUTS
        System.Collections.Specialized.OrderedDictionary. enabledPlugins and
        extraKnownMarketplaces, each present only when it has entries.
    .EXAMPLE
        $file = '/home/me/ai-harness/claude/plugins.json'
        $plugins = Read-HarnessPluginManifest -Path $file
        Get-HarnessPluginSetting -PluginManifest $plugins

        Returns the settings that enable the listed plugins.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([System.Collections.Specialized.OrderedDictionary])]
    param(
        [Parameter(Mandatory)]
        [PSCustomObject]$PluginManifest
    )

    try {
        $ErrorActionPreference = 'Stop'

        $result = [OrderedDictionary]::new([StringComparer]::Ordinal)
        $marketplaces = [OrderedDictionary]::new([StringComparer]::Ordinal)
        foreach ($marketplace in $PluginManifest.Marketplaces) {
            $entry = [OrderedDictionary]::new([StringComparer]::Ordinal)
            $entry['source'] = ConvertTo-HarnessMarketplaceSource -Source $marketplace.Source -Ref $marketplace.Ref
            $marketplaces[$marketplace.Name] = $entry
        }

        $enabled = [OrderedDictionary]::new([StringComparer]::Ordinal)
        foreach ($plugin in $PluginManifest.Plugins) {
            if ($plugin.Scope -ceq 'user') {
                $enabled[$plugin.Id] = $true
            }
        }

        if ($enabled.PSBase.Count -gt 0) {
            $result['enabledPlugins'] = $enabled
        }

        if ($marketplaces.PSBase.Count -gt 0) {
            $result['extraKnownMarketplaces'] = $marketplaces
        }

        return $result
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Read-HarnessMcpManifest {
    <#
    .SYNOPSIS
        Returns the servers listed in claude/mcp.json.
    .DESCRIPTION
        Each server's configuration comes back as compact JSON, ready for
        "claude mcp add-json". Never print it: it may name environment
        variables that hold secrets.
    .PARAMETER Path
        The full path of the MCP manifest.
    .INPUTS
        None.
    .OUTPUTS
        System.Management.Automation.PSCustomObject. Name and Json, one record
        per server.
    .EXAMPLE
        Read-HarnessMcpManifest -Path /home/me/ai-harness/claude/mcp.json

        Returns the MCP servers to register.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory)]
        [string]$Path
    )

    try {
        $ErrorActionPreference = 'Stop'

        $data = Read-HarnessJson -Path $Path
        Assert-HarnessObject -Value $data -Where $Path
        if (-not $data.Contains('mcpServers')) {
            return
        }

        $servers = $data['mcpServers']
        Assert-HarnessObject -Value $servers -Where "$Path mcpServers"
        $records = foreach ($entry in $servers.GetEnumerator()) {
            if ($entry.Key -notmatch $script:NamePattern) {
                throw "$Path mcpServers has an invalid server name: it must match $script:NamePattern."
            }

            Assert-HarnessObject -Value $entry.Value -Where "$Path mcpServers.$($entry.Key)"
            [PSCustomObject]@{
                Name = $entry.Key
                Json = Write-HarnessJsonString -Value $entry.Value
            }
        }

        return $records
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

