function Write-HarnessFile {
    <#
    .SYNOPSIS
        Writes text to a file as UTF-8 without a byte order mark.
    .DESCRIPTION
        Creates the parent folder when it is missing. The text is written as
        given, line endings included.
    .PARAMETER Path
        The full path of the file.
    .PARAMETER Text
        The text to write.
    .PARAMETER WhatIf
        Shows what would happen if the command runs. The command is not run.
    .PARAMETER Confirm
        Prompts for confirmation before the command runs.
    .INPUTS
        None.
    .OUTPUTS
        None. The file is written; nothing is returned.
    .EXAMPLE
        Write-HarnessFile -Path $HOME/.claude/CLAUDE.md -Text $text

        Writes the generated instructions.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding(SupportsShouldProcess)]
    param(
        [Parameter(Mandatory)]
        [string]$Path,

        [Parameter(Mandatory)]
        [AllowEmptyString()]
        [string]$Text
    )

    try {
        $ErrorActionPreference = 'Stop'

        if (-not $PSCmdlet.ShouldProcess($Path, 'Write the file')) {
            return
        }

        $parent = [IO.Path]::GetDirectoryName($Path)
        if (-not [IO.Directory]::Exists($parent)) {
            $null = New-Item -ItemType Directory -Path $parent -Force -Confirm:$false
        }

        [IO.File]::WriteAllText($Path, $Text, [Text.UTF8Encoding]::new($false))
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Build-HarnessInstruction {
    <#
    .SYNOPSIS
        Returns the text of a generated instruction file.
    .DESCRIPTION
        The first line says the file is generated, from which source, and the
        sha256 of the body below it, so a later edit below the header can be
        told apart from an untouched copy. Then comes the source, and, when a
        local fragment is given, a blank line, a comment naming the fragment,
        and the fragment. The whole text uses the source's line ending.
    .PARAMETER Source
        The full path of the source file.
    .PARAMETER SourceName
        The source as the manifest names it, for the header.
    .PARAMETER Local
        The full path of the local fragment, if one is to be appended.
    .PARAMETER LocalName
        The fragment as the manifest names it, for its comment.
    .INPUTS
        None.
    .OUTPUTS
        System.String. The file's text.
    .EXAMPLE
        $source = Join-Path (Get-HarnessRoot) 'claude' 'CLAUDE.md'
        Build-HarnessInstruction -Source $source -SourceName claude/CLAUDE.md

        Returns the generated text without a local fragment.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)]
        [string]$Source,

        [Parameter(Mandatory)]
        [string]$SourceName,

        [string]$Local,

        [string]$LocalName
    )

    try {
        $ErrorActionPreference = 'Stop'

        $body = Read-HarnessText -Path $Source
        $newLine = Get-HarnessNewLine -Text $body
        $lines = [List[string]]::new()
        $lines.Add($body.TrimEnd())
        if ($Local) {
            $lines.Add('')
            $lines.Add("<!-- local: $(if ($LocalName) { $LocalName } else { $Local }) -->")
            $lines.Add((Read-HarnessText -Path $Local).TrimEnd())
        }

        $bodyText = (($lines -join $newLine) + $newLine) -replace '\r?\n', $newLine
        $hash = Get-HarnessHash -Text $bodyText
        $header = "$script:GeneratedPrefix$SourceName; $script:GeneratedHashLabel$hash$script:GeneratedSuffix"
        return "$header$newLine$bodyText"
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Get-HarnessGeneratedState {
    <#
    .SYNOPSIS
        Tells whether a file was generated by the harness, and whether its
        body still matches the hash in its header.
    .DESCRIPTION
        Reads the first line and the body below it. A file with no header was
        made by hand. A header that carries no sha256 (an older version wrote
        it) is generated but unproven, so a caller treats it like a hand-made
        file and backs it up. A header whose sha256 no longer matches the body
        was edited below the header: that is drift.
    .PARAMETER Path
        The full path of the file.
    .INPUTS
        None.
    .OUTPUTS
        System.Management.Automation.PSCustomObject. Exists, Generated,
        HashKnown and HashMatches.
    .EXAMPLE
        Get-HarnessGeneratedState -Path $HOME/.claude/CLAUDE.md

        Tells whether CLAUDE.md was generated and is unedited.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory)]
        [string]$Path
    )

    try {
        $ErrorActionPreference = 'Stop'

        $state = [PSCustomObject]@{
            Exists      = $false
            Generated   = $false
            HashKnown   = $false
            HashMatches = $false
        }
        if (-not [IO.File]::Exists($Path)) {
            return $state
        }

        $state.Exists = $true
        $text = (Read-HarnessText -Path $Path)
        $break = [regex]::Match($text, '\r?\n')
        $firstLine = if ($break.Success) { $text.Substring(0, $break.Index) } else { $text }
        if (-not $firstLine.StartsWith($script:GeneratedPrefix, 'Ordinal')) {
            return $state
        }

        $state.Generated = $true
        $hash = [regex]::Match($firstLine, "$script:GeneratedHashLabel([0-9a-f]+)")
        if (-not $hash.Success) {
            return $state
        }

        $state.HashKnown = $true
        $body = if ($break.Success) { $text.Substring($break.Index + $break.Length) } else { '' }
        $state.HashMatches = (Get-HarnessHash -Text $body) -ceq $hash.Groups[1].Value
        return $state
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

