#Requires -Version 7.4

using namespace System.Collections
using namespace System.Collections.Generic
using namespace System.Collections.Specialized

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

class HarnessNumber {
    # Carries a JSON number as its exact source text, so canonicalising and
    # writing never reformat 1 as 1.0, 1e3 as 1000.0, or a big integer into
    # exponent form.
    [string]$Raw

    HarnessNumber([string]$raw) {
        $this.Raw = $raw
    }

    [string] ToString() {
        return $this.Raw
    }
}

$script:GeneratedPrefix = '<!-- Generated by ai-harness from '
$script:GeneratedHashLabel = 'sha256='
$script:GeneratedSuffix = '; edit the source, not this file. -->'
$script:NamePattern = '^[A-Za-z0-9][A-Za-z0-9._-]*$'
$script:SourcePattern = '^(?:[A-Za-z0-9][A-Za-z0-9._/-]*(?:[#@][A-Za-z0-9._/-]+)?|https?://\S+)$'
$script:LocalConfigKeys = @('PersonalRoot', 'WorkRoot')

#region Private

function ConvertTo-CommandError {
    <#
    .SYNOPSIS
        Returns the error record a public function raises when something in
        it failed.
    .DESCRIPTION
        Not exported. Keeps the failure's own exception and target, gives it
        an error ID that names the exception type and a category a caller can
        act on, and leaves a record that already has a real ID and category
        (an error from a built-in cmdlet) as it is.
    .PARAMETER ErrorRecord
        The failure that was caught.
    .PARAMETER Command
        The name of the public function that caught it.
    .OUTPUTS
        The record to pass to ThrowTerminatingError.
    #>
    [CmdletBinding()]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute(
        'PSReviewUnusedParameter',
        '',
        Justification = 'Part of the call every public function makes; PowerShell appends the command name to the ID.')]
    [OutputType([System.Management.Automation.ErrorRecord])]
    param(
        [Parameter(Mandatory)]
        [System.Management.Automation.ErrorRecord]$ErrorRecord,

        [Parameter(Mandatory)]
        [string]$Command
    )

    $exception = $ErrorRecord.Exception
    $category = $ErrorRecord.CategoryInfo.Category
    if ($category -in 'NotSpecified', 'OperationStopped') {
        $category = switch ($exception) {
            { $_ -is [System.ArgumentException] } { 'InvalidArgument'; break }
            { $_ -is [System.Management.Automation.ItemNotFoundException] -or
                $_ -is [System.IO.FileNotFoundException] -or
                $_ -is [System.IO.DirectoryNotFoundException] } { 'ObjectNotFound'; break }
            { $_ -is [System.UnauthorizedAccessException] } { 'PermissionDenied'; break }
            { $_ -is [System.TimeoutException] } { 'OperationTimeout'; break }
            default { 'InvalidOperation' }
        }
    }

    $errorId = $ErrorRecord.FullyQualifiedErrorId
    if ($errorId -ceq $exception.Message -or $errorId -match '\s') {
        $errorId = $exception.GetType().Name
    }

    return [System.Management.Automation.ErrorRecord]::new($exception, $errorId, $category, $ErrorRecord.TargetObject)
}

function ConvertFrom-HarnessJsonElement {
    [CmdletBinding()]
    [OutputType([OrderedDictionary], [object[]], [string], [bool], [HarnessNumber])]
    param(
        [Parameter(Mandatory)]
        [System.Text.Json.JsonElement]$Element
    )

    switch ($Element.ValueKind.ToString()) {
        'Object' {
            $result = [OrderedDictionary]::new([StringComparer]::Ordinal)
            foreach ($property in $Element.EnumerateObject()) {
                $result[$property.Name] = ConvertFrom-HarnessJsonElement -Element $property.Value
            }

            return $result
        }
        'Array' {
            $items = [List[object]]::new()
            foreach ($item in $Element.EnumerateArray()) {
                $items.Add((ConvertFrom-HarnessJsonElement -Element $item))
            }

            return , $items.ToArray()
        }
        'String' {
            return $Element.GetString()
        }
        'Number' {
            return [HarnessNumber]::new($Element.GetRawText())
        }
        'True' {
            return $true
        }
        'False' {
            return $false
        }
        default {
            return $null
        }
    }
}

function New-HarnessJsonOption {
    [CmdletBinding()]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute(
        'PSUseShouldProcessForStateChangingFunctions',
        '',
        Justification = 'Builds an options value in memory; nothing outside the process changes.')]
    [OutputType([System.Text.Json.JsonDocumentOptions])]
    param()

    $options = [System.Text.Json.JsonDocumentOptions]::new()
    $options.CommentHandling = [System.Text.Json.JsonCommentHandling]::Skip
    $options.AllowTrailingCommas = $true
    return $options
}

function ConvertFrom-HarnessJsonText {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [AllowEmptyString()]
        [string]$Text
    )

    # System.Text.Json, not ConvertFrom-Json: in 7.4 that turns ISO-date strings into DateTime.
    $document = [System.Text.Json.JsonDocument]::Parse($Text, (New-HarnessJsonOption))
    try {
        $value = ConvertFrom-HarnessJsonElement -Element $document.RootElement
    }
    finally {
        $document.Dispose()
    }

    return $value
}

function Copy-HarnessValue {
    [CmdletBinding()]
    [OutputType([OrderedDictionary], [object[]], [string], [bool], [HarnessNumber])]
    param(
        [AllowNull()]
        [object]$Value
    )

    if ($Value -is [IDictionary]) {
        $copy = [OrderedDictionary]::new([StringComparer]::Ordinal)
        foreach ($entry in $Value.GetEnumerator()) {
            $copy[$entry.Key] = Copy-HarnessValue -Value $entry.Value
        }

        return $copy
    }

    if ($Value -is [IList]) {
        $items = [List[object]]::new()
        foreach ($item in $Value) {
            $items.Add((Copy-HarnessValue -Value $item))
        }

        return , $items.ToArray()
    }

    return $Value
}

function Write-HarnessJsonString {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [AllowNull()]
        [object]$Value,

        [switch]$Sort,

        [int]$IndentWidth = 0,

        [int]$Depth = 0
    )

    if ($null -eq $Value) {
        return 'null'
    }

    if ($Value -is [HarnessNumber]) {
        return $Value.Raw
    }

    if ($Value -is [bool]) {
        return $(if ($Value) { 'true' } else { 'false' })
    }

    if ($Value -isnot [IDictionary] -and $Value -isnot [IList]) {
        # ConvertTo-Json gives a scalar the house's readable escaping (it leaves < > & as written).
        return (ConvertTo-Json -InputObject $Value -Compress)
    }

    $pretty = $IndentWidth -gt 0
    $pad = if ($pretty) { ' ' * ($IndentWidth * ($Depth + 1)) } else { '' }
    $close = if ($pretty) { ' ' * ($IndentWidth * $Depth) } else { '' }
    $sep = if ($pretty) { ",`n" } else { ',' }
    $colon = if ($pretty) { ': ' } else { ':' }

    $parts = [List[string]]::new()
    if ($Value -is [IDictionary]) {
        $keys = [List[string]]::new()
        foreach ($entry in $Value.GetEnumerator()) {
            $keys.Add($entry.Key)
        }

        if ($Sort) {
            $keys = [List[string]]($keys | Sort-Object -CaseSensitive)
        }

        if ($keys.Count -eq 0) {
            return '{}'
        }

        foreach ($key in $keys) {
            $name = ConvertTo-Json -InputObject $key -Compress
            $child = $Value[$key]
            $inner = Write-HarnessJsonString -Value $child -Sort:$Sort -IndentWidth $IndentWidth -Depth ($Depth + 1)
            $parts.Add("$pad$name$colon$inner")
        }

        if ($pretty) {
            return "{`n" + ($parts -join $sep) + "`n$close}"
        }

        return '{' + ($parts -join $sep) + '}'
    }

    if ($Value.Count -eq 0) {
        return '[]'
    }

    foreach ($item in $Value) {
        $inner = Write-HarnessJsonString -Value $item -Sort:$Sort -IndentWidth $IndentWidth -Depth ($Depth + 1)
        $parts.Add("$pad$inner")
    }

    if ($pretty) {
        return "[`n" + ($parts -join $sep) + "`n$close]"
    }

    return '[' + ($parts -join $sep) + ']'
}

function Get-HarnessCanonicalJson {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [AllowNull()]
        [object]$Value
    )

    # Keys are sorted so that two objects with the same entries in a different
    # order are one value: an array dedupe keeps one copy, and a compare sees
    # no change. Numbers keep their source text (HarnessNumber), so 1 and 1.0
    # are not mistaken for a change.
    return (Write-HarnessJsonString -Value $Value -Sort)
}

function Merge-HarnessValue {
    [CmdletBinding()]
    [OutputType([OrderedDictionary], [object[]], [string], [bool], [HarnessNumber])]
    param(
        [AllowNull()]
        [object]$Base,

        [AllowNull()]
        [object]$Overlay
    )

    if ($Base -is [IDictionary] -and $Overlay -is [IDictionary]) {
        $result = Copy-HarnessValue -Value $Base
        foreach ($entry in $Overlay.GetEnumerator()) {
            $merged = if ($result.Contains($entry.Key)) {
                Merge-HarnessValue -Base $result[$entry.Key] -Overlay $entry.Value
            }
            else {
                Copy-HarnessValue -Value $entry.Value
            }

            $result[$entry.Key] = $merged
        }

        return $result
    }

    if ($Base -is [IList] -and $Overlay -is [IList]) {
        $seen = [HashSet[string]]::new([StringComparer]::Ordinal)
        $items = [List[object]]::new()
        foreach ($item in @($Base) + @($Overlay)) {
            if ($seen.Add((Get-HarnessCanonicalJson -Value $item))) {
                $items.Add((Copy-HarnessValue -Value $item))
            }
        }

        return , $items.ToArray()
    }

    return (Copy-HarnessValue -Value $Overlay)
}

function Expand-HarnessValue {
    [CmdletBinding()]
    [OutputType([OrderedDictionary], [object[]], [string], [bool], [HarnessNumber])]
    param(
        [AllowNull()]
        [object]$Value,

        [Parameter(Mandatory)]
        [hashtable]$Token
    )

    if ($Value -is [string]) {
        $text = $Value
        foreach ($entry in $Token.GetEnumerator()) {
            $text = $text.Replace("{{$($entry.Key)}}", [string]$entry.Value)
        }

        return $text
    }

    if ($Value -is [IDictionary]) {
        $result = [OrderedDictionary]::new([StringComparer]::Ordinal)
        foreach ($entry in $Value.GetEnumerator()) {
            $result[$entry.Key] = Expand-HarnessValue -Value $entry.Value -Token $Token
        }

        return $result
    }

    if ($Value -is [IList]) {
        $items = [List[object]]::new()
        foreach ($item in $Value) {
            $items.Add((Expand-HarnessValue -Value $item -Token $Token))
        }

        return , $items.ToArray()
    }

    return $Value
}

function Join-HarnessJsonPath {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [AllowEmptyString()]
        [string]$Parent,

        [Parameter(Mandatory)]
        [AllowEmptyString()]
        [string]$Key
    )

    if ($Key -notmatch '^[A-Za-z0-9_@-]+$') {
        return "$Parent[$(ConvertTo-Json -InputObject $Key -Compress)]"
    }

    if ([string]::IsNullOrEmpty($Parent)) {
        return $Key
    }

    return "$Parent.$Key"
}

function Compare-HarnessValue {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [object]$Reference,

        [AllowNull()]
        [object]$Difference,

        [AllowEmptyString()]
        [string]$Path,

        [Parameter(Mandatory)]
        [AllowEmptyCollection()]
        [List[object]]$Result
    )

    if ($Reference -is [IDictionary] -and $Difference -is [IDictionary]) {
        foreach ($entry in $Reference.GetEnumerator()) {
            $child = Join-HarnessJsonPath -Parent $Path -Key $entry.Key
            if ($Difference.Contains($entry.Key)) {
                $now = $Difference[$entry.Key]
                Compare-HarnessValue -Reference $entry.Value -Difference $now -Path $child -Result $Result
                continue
            }

            $Result.Add((New-HarnessDifference -Path $child -Change 'Removed' -Previous $entry.Value))
        }

        foreach ($entry in $Difference.GetEnumerator()) {
            if (-not $Reference.Contains($entry.Key)) {
                $child = Join-HarnessJsonPath -Parent $Path -Key $entry.Key
                $Result.Add((New-HarnessDifference -Path $child -Change 'Added' -Value $entry.Value))
            }
        }

        return
    }

    if ($Reference -is [IList] -and $Difference -is [IList]) {
        $referenceKeys = [HashSet[string]]::new([StringComparer]::Ordinal)
        foreach ($item in $Reference) {
            $null = $referenceKeys.Add((Get-HarnessCanonicalJson -Value $item))
        }

        $differenceKeys = [HashSet[string]]::new([StringComparer]::Ordinal)
        foreach ($item in $Difference) {
            $null = $differenceKeys.Add((Get-HarnessCanonicalJson -Value $item))
            if (-not $referenceKeys.Contains((Get-HarnessCanonicalJson -Value $item))) {
                $Result.Add((New-HarnessDifference -Path $Path -Change 'Added' -Value $item))
            }
        }

        foreach ($item in $Reference) {
            if (-not $differenceKeys.Contains((Get-HarnessCanonicalJson -Value $item))) {
                $Result.Add((New-HarnessDifference -Path $Path -Change 'Removed' -Previous $item))
            }
        }

        return
    }

    if ((Get-HarnessCanonicalJson -Value $Reference) -cne (Get-HarnessCanonicalJson -Value $Difference)) {
        $Result.Add((New-HarnessDifference -Path $Path -Change 'Changed' -Value $Difference -Previous $Reference))
    }
}

function New-HarnessDifference {
    [CmdletBinding()]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute(
        'PSUseShouldProcessForStateChangingFunctions',
        '',
        Justification = 'Builds a record in memory; nothing outside the process changes.')]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory)]
        [AllowEmptyString()]
        [string]$Path,

        [Parameter(Mandatory)]
        [string]$Change,

        [AllowNull()]
        [object]$Value,

        [AllowNull()]
        [object]$Previous
    )

    return [PSCustomObject]@{
        Path     = $Path
        Change   = $Change
        Value    = $Value
        Previous = $Previous
    }
}

function Get-HarnessManifestString {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)]
        [IDictionary]$Entry,

        [Parameter(Mandatory)]
        [string]$Name,

        [Parameter(Mandatory)]
        [string]$Where,

        [string]$Pattern = '\S',

        [switch]$Optional
    )

    if (-not $Entry.Contains($Name)) {
        if ($Optional) {
            return
        }

        throw "$Where has no `"$Name`"."
    }

    $value = $Entry[$Name]
    if ($value -isnot [string] -or $value -cnotmatch $Pattern) {
        throw "$Where has an invalid `"$Name`": it must be a string matching $Pattern."
    }

    return $value
}

function Get-HarnessManifestList {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [IDictionary]$Entry,

        [Parameter(Mandatory)]
        [string]$Name,

        [Parameter(Mandatory)]
        [string]$Where
    )

    if (-not $Entry.Contains($Name)) {
        return
    }

    $value = $Entry[$Name]
    if ($value -isnot [IList]) {
        throw "$Where has an invalid `"$Name`": it must be an array."
    }

    return $value
}

function Get-HarnessManifestBool {
    [CmdletBinding()]
    [OutputType([bool])]
    param(
        [Parameter(Mandatory)]
        [IDictionary]$Entry,

        [Parameter(Mandatory)]
        [string]$Name,

        [Parameter(Mandatory)]
        [string]$Where
    )

    if (-not $Entry.Contains($Name)) {
        return $false
    }

    $value = $Entry[$Name]
    if ($value -isnot [bool]) {
        throw "$Where has an invalid `"$Name`": it must be true or false."
    }

    return $value
}

function ConvertTo-HarnessMarketplaceSource {
    [CmdletBinding()]
    [OutputType([System.Collections.Specialized.OrderedDictionary])]
    param(
        [Parameter(Mandatory)]
        [string]$Source,

        [string]$Ref
    )

    $result = [OrderedDictionary]::new([StringComparer]::Ordinal)
    $isUrl = $Source -match '^https?://'
    if ($Source -match '^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$') {
        $result['source'] = 'github'
        $result['repo'] = $Source
    }
    elseif ($Source -match '^[^@/\s]+@[^:\s]+:' -or ($isUrl -and $Source -match '\.git$|/_git/')) {
        $result['source'] = 'git'
        $result['url'] = $Source
    }
    elseif ($isUrl) {
        $result['source'] = 'url'
        $result['url'] = $Source
    }
    else {
        $result['source'] = if ($Source -match '\.json$') { 'file' } else { 'directory' }
        $result['path'] = $Source
    }

    if ($Ref -and $result['source'] -in 'github', 'git') {
        $result['ref'] = $Ref
    }

    return $result
}

function Assert-HarnessObject {
    [CmdletBinding()]
    param(
        [AllowNull()]
        [object]$Value,

        [Parameter(Mandatory)]
        [string]$Where
    )

    if ($Value -isnot [IDictionary]) {
        throw "$Where is not a JSON object."
    }
}

function Assert-HarnessKey {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [IDictionary]$Entry,

        [Parameter(Mandatory)]
        [string[]]$Allowed,

        [Parameter(Mandatory)]
        [string]$Where
    )

    # PSBase, because a key named "Keys" would stand in for the property.
    $unknown = @($Entry.PSBase.Keys | Where-Object { $Allowed -cnotcontains $_ })
    if ($unknown.Count -eq 0) {
        return
    }

    $noun = if ($unknown.Count -eq 1) { 'key' } else { 'keys' }
    $names = @($unknown | ForEach-Object { ConvertTo-Json -InputObject $_ -Compress }) -join ', '
    throw "${Where}: unknown $noun $names (allowed: $($Allowed -join ', '))."
}

function Resolve-HarnessCommand {
    [CmdletBinding()]
    [OutputType([System.Management.Automation.CommandInfo])]
    param(
        [Parameter(Mandatory)]
        [string]$Name
    )

    return (Get-Command -Name $Name -CommandType Application, ExternalScript -ErrorAction Ignore |
        Select-Object -First 1)
}

function Get-HarnessHash {
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)]
        [AllowEmptyString()]
        [string]$Text
    )

    $bytes = [Text.UTF8Encoding]::new($false).GetBytes($Text)
    return [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($bytes)).ToLowerInvariant()
}

