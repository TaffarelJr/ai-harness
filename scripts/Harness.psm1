function Get-HarnessSettingDrift {
    <#
    .SYNOPSIS
        Compares a generated settings file with the sidecar the installer
        wrote, and reports what changed since.
    .DESCRIPTION
        The sidecar records what was last generated, so a difference is what
        Claude Code or a person changed afterwards. Status is Missing (no
        target), NoSidecar (the harness did not write the target), Unreadable
        (the target or sidecar cannot be read or parsed; Reason says which and
        why), Clean, or Drift.
    .PARAMETER Target
        The full path of the generated settings file.
    .INPUTS
        None.
    .OUTPUTS
        System.Management.Automation.PSCustomObject. Target, Sidecar, Status,
        Reason and Difference (the Compare-HarnessObject records for Drift).
    .EXAMPLE
        Get-HarnessSettingDrift -Target $HOME/.claude/settings.json

        Lists what changed in the settings since the last install.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory)]
        [string]$Target
    )

    try {
        $ErrorActionPreference = 'Stop'

        $sidecar = Get-HarnessSidecarPath -Path $Target
        $record = [PSCustomObject]@{
            Target     = $Target
            Sidecar    = $sidecar
            Status     = 'Missing'
            Reason     = $null
            Difference = @()
        }
        if (-not [IO.File]::Exists($Target)) {
            return $record
        }

        if (-not [IO.File]::Exists($sidecar)) {
            $record.Status = 'NoSidecar'
            return $record
        }

        try {
            $before = Read-HarnessJson -Path $sidecar -HideDetail
            $now = Read-HarnessJson -Path $Target -HideDetail
        }
        catch {
            # The message names the file and why (not UTF-8, not valid JSON, not an object), never its text.
            $record.Status = 'Unreadable'
            $record.Reason = $_.Exception.Message
            return $record
        }

        $record.Difference = @(Compare-HarnessObject -Reference $before -Difference $now)
        $record.Status = if ($record.Difference.Count -gt 0) { 'Drift' } else { 'Clean' }
        return $record
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Invoke-HarnessStep {
    <#
    .SYNOPSIS
        Runs one step and reports it as a single progress line.
    .DESCRIPTION
        Prints "<activity> ... " and then the step's outcome: the last string
        the script block returns, or "done". A failure prints "failed" and is
        raised again. Warnings the step writes are shown after its line. With
        -WhatIf the line is printed once the step ends, after the step's own
        "What if:" lines.
    .PARAMETER Activity
        What the step attempts, such as "Linking ~/.claude/skills".
    .PARAMETER ScriptBlock
        The step. Return a short outcome string, such as "already linked".
    .INPUTS
        None.
    .OUTPUTS
        None. The progress line is written to the host.
    .EXAMPLE
        Invoke-HarnessStep -Activity 'Linking skills' -ScriptBlock { 'linked' }

        Prints "Linking skills ... linked".
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute(
        'PSAvoidUsingWriteHost',
        '',
        Justification = 'The progress line is for the person at the console, not data.')]
    param(
        [Parameter(Mandatory)]
        [string]$Activity,

        [Parameter(Mandatory)]
        [scriptblock]$ScriptBlock
    )

    $warnings = [List[System.Management.Automation.WarningRecord]]::new()
    $outputs = [List[object]]::new()
    $whatIf = [bool]$PSCmdlet.GetVariableValue('WhatIfPreference')
    try {
        $ErrorActionPreference = 'Stop'

        if (-not $whatIf) {
            Write-Host "$Activity ... " -NoNewline -ForegroundColor Cyan
        }

        & $ScriptBlock 3>&1 | ForEach-Object {
            if ($_ -is [System.Management.Automation.WarningRecord]) {
                $warnings.Add($_)
            }
            else {
                $outputs.Add($_)
            }
        }
    }
    catch {
        $failure = $_
        if ($whatIf) {
            Write-Host "$Activity ... " -NoNewline -ForegroundColor Cyan
        }

        Write-Host 'failed' -ForegroundColor Red
        foreach ($warning in $warnings) {
            Write-Warning $warning.Message
        }

        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $failure -Command $MyInvocation.MyCommand.Name))
    }

    $outcome = @($outputs | Where-Object { $_ -is [string] }) | Select-Object -Last 1
    if ([string]::IsNullOrWhiteSpace($outcome)) {
        $outcome = 'done'
    }

    $color = switch -Regex ($outcome) {
        '^(skipped|would)' { 'Yellow'; break }
        '^(already|unchanged|up to date|none)' { 'DarkGray'; break }
        default { 'Green' }
    }

    if ($whatIf) {
        Write-Host "$Activity ... " -NoNewline -ForegroundColor Cyan
    }

    Write-Host $outcome -ForegroundColor $color
    foreach ($warning in $warnings) {
        Write-Warning $warning.Message
    }
}

