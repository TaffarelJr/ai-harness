function Get-HarnessRoot {
    <#
    .SYNOPSIS
        Returns the full path of the harness checkout.
    .INPUTS
        None.
    .OUTPUTS
        System.String. The folder that holds harness.json and scripts/.
    .EXAMPLE
        Get-HarnessRoot

        Returns the checkout this module was loaded from.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param()

    try {
        $ErrorActionPreference = 'Stop'

        return [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..'))
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Read-HarnessText {
    <#
    .SYNOPSIS
        Returns the text of a UTF-8 file, without a byte order mark.
    .DESCRIPTION
        Decodes strictly, so a file in another encoding fails instead of
        coming back with replacement characters.
    .PARAMETER Path
        The full path of the file.
    .INPUTS
        None.
    .OUTPUTS
        System.String. The file's text, line endings untouched.
    .EXAMPLE
        Read-HarnessText -Path (Join-Path (Get-HarnessRoot) 'harness.json')

        Returns the manifest's text.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)]
        [string]$Path
    )

    try {
        $ErrorActionPreference = 'Stop'

        if (-not [IO.File]::Exists($Path)) {
            throw "Reading $Path failed: the file does not exist."
        }

        try {
            $text = [IO.File]::ReadAllText($Path, [Text.UTF8Encoding]::new($false, $true))
        }
        catch [Text.DecoderFallbackException] {
            throw "Reading $Path failed: it is not UTF-8 text."
        }

        return $text.TrimStart([char]0xFEFF)
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Read-HarnessJson {
    <#
    .SYNOPSIS
        Returns the parsed content of a JSON file.
    .DESCRIPTION
        Objects become ordered dictionaries with case-sensitive keys, arrays
        become arrays, numbers keep their source text, and strings stay
        strings (a date is not converted). Comments and trailing commas are
        tolerated. The top level must be an object; anything else fails.
    .PARAMETER Path
        The full path of the file.
    .PARAMETER HideDetail
        Leaves the parser's own message out of a failure, because it quotes
        the text it could not read. Use it for any file under local/.
    .INPUTS
        None.
    .OUTPUTS
        System.Collections.Specialized.OrderedDictionary. The parsed object.
    .EXAMPLE
        Read-HarnessJson -Path (Join-Path (Get-HarnessRoot) 'harness.json')

        Returns the manifest as a dictionary.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([System.Collections.Specialized.OrderedDictionary])]
    param(
        [Parameter(Mandatory)]
        [string]$Path,

        [switch]$HideDetail
    )

    try {
        $ErrorActionPreference = 'Stop'

        $text = Read-HarnessText -Path $Path
        if ([string]::IsNullOrWhiteSpace($text)) {
            throw "Reading $Path failed: the file is empty."
        }

        try {
            $value = ConvertFrom-HarnessJsonText -Text $text
        }
        catch {
            $reason = 'it is not valid JSON'
            if (-not $HideDetail) {
                $reason += ": $($_.Exception.GetBaseException().Message)"
            }

            throw "Reading $Path failed: $reason"
        }

        # A one-element top-level array would unwrap to its element on return and pass as an object.
        if ($value -isnot [IDictionary]) {
            throw "Reading $Path failed: its top level is not a JSON object."
        }

        return $value
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Read-HarnessManifest {
    <#
    .SYNOPSIS
        Returns the checked content of harness.json.
    .DESCRIPTION
        Fails with a message naming the entry when a required field is missing
        or has the wrong type, or when a key is not one the manifest knows;
        keys are case-sensitive. Paths are returned as written; resolve them
        with Resolve-HarnessPath.
    .PARAMETER Root
        The checkout that holds harness.json.
    .INPUTS
        None.
    .OUTPUTS
        System.Management.Automation.PSCustomObject. Path, Links, Instructions,
        Settings, Modules, Plugins and Mcp.
    .EXAMPLE
        Read-HarnessManifest -Root (Get-HarnessRoot)

        Returns the manifest of this checkout.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory)]
        [string]$Root
    )

    try {
        $ErrorActionPreference = 'Stop'

        $path = Join-Path $Root 'harness.json'
        $data = Read-HarnessJson -Path $path
        Assert-HarnessObject -Value $data -Where $path
        $sections = 'Links', 'Instructions', 'Settings', 'PowerShellModules', 'Plugins', 'Mcp'
        Assert-HarnessKey -Entry $data -Allowed $sections -Where $path

        $entries = @(Get-HarnessManifestList -Entry $data -Name 'Links' -Where $path)
        $links = for ($i = 0; $i -lt $entries.Count; $i++) {
            $where = "$path Links[$i]"
            Assert-HarnessObject -Value $entries[$i] -Where $where
            Assert-HarnessKey -Entry $entries[$i] -Allowed 'Source', 'Target' -Where $where
            [PSCustomObject]@{
                Source = Get-HarnessManifestString -Entry $entries[$i] -Name 'Source' -Where $where
                Target = Get-HarnessManifestString -Entry $entries[$i] -Name 'Target' -Where $where
            }
        }

        $entries = @(Get-HarnessManifestList -Entry $data -Name 'Instructions' -Where $path)
        $instructions = for ($i = 0; $i -lt $entries.Count; $i++) {
            $where = "$path Instructions[$i]"
            Assert-HarnessObject -Value $entries[$i] -Where $where
            Assert-HarnessKey -Entry $entries[$i] -Allowed 'Source', 'Local', 'Targets' -Where $where
            $targets = @(Get-HarnessManifestList -Entry $entries[$i] -Name 'Targets' -Where $where)
            $invalid = @($targets | Where-Object { $_ -isnot [string] -or $_ -notmatch '\S' })
            if ($targets.Count -eq 0 -or $invalid.Count -gt 0) {
                throw "$where has an invalid `"Targets`": it must be a non-empty array of paths."
            }

            [PSCustomObject]@{
                Source  = Get-HarnessManifestString -Entry $entries[$i] -Name 'Source' -Where $where
                Local   = Get-HarnessManifestString -Entry $entries[$i] -Name 'Local' -Where $where -Optional
                Targets = [string[]]$targets
            }
        }

        $entries = @(Get-HarnessManifestList -Entry $data -Name 'Settings' -Where $path)
        $settings = for ($i = 0; $i -lt $entries.Count; $i++) {
            $where = "$path Settings[$i]"
            Assert-HarnessObject -Value $entries[$i] -Where $where
            Assert-HarnessKey -Entry $entries[$i] -Allowed 'Source', 'Local', 'Target', 'Plugins' -Where $where
            [PSCustomObject]@{
                Source  = Get-HarnessManifestString -Entry $entries[$i] -Name 'Source' -Where $where
                Local   = Get-HarnessManifestString -Entry $entries[$i] -Name 'Local' -Where $where -Optional
                Target  = Get-HarnessManifestString -Entry $entries[$i] -Name 'Target' -Where $where
                Plugins = Get-HarnessManifestBool -Entry $entries[$i] -Name 'Plugins' -Where $where
            }
        }

        $platformPattern = '^(?:windows|linux|macos)$'
        $entries = @(Get-HarnessManifestList -Entry $data -Name 'PowerShellModules' -Where $path)
        $modules = for ($i = 0; $i -lt $entries.Count; $i++) {
            $field = @{
                Entry = $entries[$i]
                Where = "$path PowerShellModules[$i]"
            }
            Assert-HarnessObject -Value $field.Entry -Where $field.Where
            Assert-HarnessKey @field -Allowed 'Name', 'Platform'
            [PSCustomObject]@{
                Name     = Get-HarnessManifestString @field -Name 'Name' -Pattern $script:NamePattern
                Platform = Get-HarnessManifestString @field -Name 'Platform' -Pattern $platformPattern -Optional
            }
        }

        return [PSCustomObject]@{
            Path         = $path
            Links        = @($links)
            Instructions = @($instructions)
            Settings     = @($settings)
            Modules      = @($modules)
            Plugins      = Get-HarnessManifestString -Entry $data -Name 'Plugins' -Where $path -Optional
            Mcp          = Get-HarnessManifestString -Entry $data -Name 'Mcp' -Where $path -Optional
        }
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Read-HarnessLocalConfig {
    <#
    .SYNOPSIS
        Returns the machine's settings from local/harness.json.
    .DESCRIPTION
        A missing file or value is not an error: that value is then $null. A
        key other than PersonalRoot and WorkRoot fails. A failure names the
        key but never quotes a value, because local/ is private to the
        machine.
    .PARAMETER LocalPath
        The local folder, normally local/ in the checkout.
    .INPUTS
        None.
    .OUTPUTS
        System.Management.Automation.PSCustomObject. Path, PersonalRoot and
        WorkRoot.
    .EXAMPLE
        Read-HarnessLocalConfig -LocalPath (Join-Path (Get-HarnessRoot) 'local')

        Returns the personal and work roots saved on this machine, if any.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory)]
        [string]$LocalPath
    )

    try {
        $ErrorActionPreference = 'Stop'

        $path = Join-Path $LocalPath 'harness.json'
        $result = [PSCustomObject]@{
            Path         = $path
            PersonalRoot = $null
            WorkRoot     = $null
        }
        if ([IO.File]::Exists($path)) {
            $data = Read-HarnessJson -Path $path -HideDetail
            Assert-HarnessObject -Value $data -Where $path
            Assert-HarnessKey -Entry $data -Allowed $script:LocalConfigKeys -Where $path
            foreach ($name in $script:LocalConfigKeys) {
                $saved = Get-HarnessManifestString -Entry $data -Name $name -Where $path -Optional
                $result.$name = Resolve-HarnessContextRoot -Path $saved
            }
        }

        return $result
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Save-HarnessLocalConfig {
    <#
    .SYNOPSIS
        Saves the personal root, the work root or both into
        local/harness.json.
    .DESCRIPTION
        Keeps the root that is not given as it is. Fails, writing nothing,
        when neither is given or when the file already holds a key other
        than PersonalRoot and WorkRoot. No value is echoed, because local/ is
        private to the machine.
    .PARAMETER LocalPath
        The local folder, normally local/ in the checkout.
    .PARAMETER PersonalRoot
        The folder that holds the personal repositories.
    .PARAMETER WorkRoot
        The folder that holds the work repositories.
    .PARAMETER WhatIf
        Shows what would happen if the command runs. The command is not run.
    .PARAMETER Confirm
        Prompts for confirmation before the command runs.
    .INPUTS
        None.
    .OUTPUTS
        None. The file is written; nothing is returned.
    .EXAMPLE
        $local = '/home/me/ai-harness/local'
        Save-HarnessLocalConfig -LocalPath $local -PersonalRoot /home/me/repos

        Records where the personal repositories live on this machine.
    .EXAMPLE
        $local = '/home/me/ai-harness/local'
        Save-HarnessLocalConfig -LocalPath $local -WorkRoot /home/me/work

        Records where the work repositories live, keeping the personal root.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding(SupportsShouldProcess)]
    param(
        [Parameter(Mandatory)]
        [string]$LocalPath,

        [string]$PersonalRoot,

        [string]$WorkRoot
    )

    try {
        $ErrorActionPreference = 'Stop'

        $roots = [ordered]@{}
        foreach ($name in $script:LocalConfigKeys) {
            if ($PSBoundParameters.ContainsKey($name)) {
                $roots[$name] = $PSBoundParameters[$name]
            }
        }

        $blank = @($roots.PSBase.Values | Where-Object { [string]::IsNullOrWhiteSpace($_) })
        if ($roots.PSBase.Count -eq 0 -or $blank.Count -gt 0) {
            throw 'Saving the local settings failed: pass a non-blank -PersonalRoot, -WorkRoot or both.'
        }

        $path = Join-Path $LocalPath 'harness.json'
        $data = [OrderedDictionary]::new([StringComparer]::Ordinal)
        $newLine = [Environment]::NewLine
        if ([IO.File]::Exists($path)) {
            $data = Read-HarnessJson -Path $path -HideDetail
            Assert-HarnessObject -Value $data -Where $path
            Assert-HarnessKey -Entry $data -Allowed $script:LocalConfigKeys -Where $path
            $newLine = Get-HarnessNewLine -Text (Read-HarnessText -Path $path)
        }

        $label = @{
            PersonalRoot = 'the personal root'
            WorkRoot     = 'the work root'
        }
        $what = @($roots.PSBase.Keys | ForEach-Object { $label[$_] }) -join ' and '
        if (-not $PSCmdlet.ShouldProcess($path, "Save $what")) {
            return
        }

        foreach ($entry in $roots.GetEnumerator()) {
            $data[$entry.Key] = $entry.Value
        }

        Write-HarnessFile -Path $path -Text (ConvertTo-HarnessJson -InputObject $data -NewLine $newLine) -Confirm:$false
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Resolve-HarnessPath {
    <#
    .SYNOPSIS
        Returns the full path a manifest path stands for.
    .DESCRIPTION
        A leading ~ is the home path, a leading local/ is the local folder,
        {personalRoot} is the personal root, {workRoot} is the work root,
        and any other relative path is taken from the checkout. Fails for an
        unknown {token}, and for {personalRoot} or {workRoot} when that root
        is not given.
    .PARAMETER Path
        The path as the manifest writes it.
    .PARAMETER Root
        The checkout.
    .PARAMETER HomePath
        The home directory that ~ stands for.
    .PARAMETER LocalPath
        The folder that local/ stands for.
    .PARAMETER PersonalRoot
        The folder that {personalRoot} stands for.
    .PARAMETER WorkRoot
        The folder that {workRoot} stands for.
    .INPUTS
        None.
    .OUTPUTS
        System.String. The full path.
    .EXAMPLE
        $root = Get-HarnessRoot
        Resolve-HarnessPath -Path '~/.claude/skills' -Root $root -HomePath $HOME

        Returns the skills folder under the home directory.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)]
        [string]$Path,

        [Parameter(Mandatory)]
        [string]$Root,

        [Parameter(Mandatory)]
        [string]$HomePath,

        [string]$LocalPath,

        [string]$PersonalRoot,

        [string]$WorkRoot
    )

    try {
        $ErrorActionPreference = 'Stop'

        $expanded = $Path
        if ($expanded -match '^~(?=$|[\\/])') {
            $expanded = $HomePath + $expanded.Substring(1)
        }
        elseif ($LocalPath -and $expanded -match '^local(?=$|[\\/])') {
            $expanded = $LocalPath + $expanded.Substring(5)
        }

        $roots = @(
            @{ Token = '{personalRoot}'; Value = $PersonalRoot; Name = 'personal root' }
            @{ Token = '{workRoot}'; Value = $WorkRoot; Name = 'work root' }
        )
        foreach ($contextRoot in $roots) {
            if (-not $expanded.Contains($contextRoot.Token)) {
                continue
            }

            if ([string]::IsNullOrWhiteSpace($contextRoot.Value)) {
                throw "Resolving $Path failed: it uses $($contextRoot.Token), and no $($contextRoot.Name) is known."
            }

            $expanded = $expanded.Replace($contextRoot.Token, $contextRoot.Value)
        }

        if ($expanded -match '\{\w+\}') {
            throw "Resolving $Path failed: $($Matches[0]) is not a known token."
        }

        if (-not [IO.Path]::IsPathRooted($expanded)) {
            $expanded = Join-Path $Root $expanded
        }

        return [IO.Path]::GetFullPath($expanded)
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Resolve-HarnessContextRoot {
    <#
    .SYNOPSIS
        Returns a context root (the personal or the work root) as a full
        path, or nothing when none is set.
    .DESCRIPTION
        Expands a leading ~ to the home directory and makes the path full, so
        a saved "~/source/personal" is not read as a literal "~" folder under
        the current directory. It does not check that the folder exists; a
        caller does that.
    .PARAMETER Path
        The root as given on the command line or saved in
        local/harness.json. Blank means none is set.
    .INPUTS
        None.
    .OUTPUTS
        System.String. The full path, or nothing.
    .EXAMPLE
        Resolve-HarnessContextRoot -Path '~/source/personal'

        Returns the personal root under the home directory.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [AllowEmptyString()]
        [AllowNull()]
        [string]$Path
    )

    try {
        $ErrorActionPreference = 'Stop'

        if ([string]::IsNullOrWhiteSpace($Path)) {
            return
        }

        $expanded = $Path
        if ($expanded -match '^~(?=$|[\\/])') {
            $expanded = $HOME + $expanded.Substring(1)
        }

        return [IO.Path]::GetFullPath($expanded)
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Get-HarnessItem {
    <#
    .SYNOPSIS
        Returns what is at a path: nothing, a file, a folder or a link.
    .DESCRIPTION
        A symbolic link (or a junction) is reported as a link even when what
        it points at is gone, with the full path it points at.
    .PARAMETER Path
        The full path to look at.
    .INPUTS
        None.
    .OUTPUTS
        System.Management.Automation.PSCustomObject. Path, Kind (Missing,
        File, Directory or Link) and LinkTarget.
    .EXAMPLE
        Get-HarnessItem -Path (Join-Path $HOME '.claude' 'skills')

        Tells whether the skills folder is a link, and where it points.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory)]
        [string]$Path
    )

    try {
        $ErrorActionPreference = 'Stop'

        $linkTarget = [IO.FileInfo]::new($Path).LinkTarget
        if ($null -ne $linkTarget) {
            $parent = [IO.Path]::GetDirectoryName($Path)
            return [PSCustomObject]@{
                Path       = $Path
                Kind       = 'Link'
                LinkTarget = [IO.Path]::GetFullPath($linkTarget, $parent)
            }
        }

        $kind = if ([IO.Directory]::Exists($Path)) {
            'Directory'
        }
        elseif ([IO.File]::Exists($Path)) {
            'File'
        }
        else {
            'Missing'
        }

        return [PSCustomObject]@{
            Path       = $Path
            Kind       = $kind
            LinkTarget = $null
        }
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Test-HarnessSamePath {
    <#
    .SYNOPSIS
        Tells whether two paths name the same place.
    .DESCRIPTION
        Both are made full and lose any trailing separator. Case is ignored
        on Windows and macOS, whose file systems ignore it by default, and
        counts on Linux.
    .PARAMETER Left
        One path.
    .PARAMETER Right
        The other path.
    .INPUTS
        None.
    .OUTPUTS
        System.Boolean. True when the paths are the same.
    .EXAMPLE
        $item = Get-HarnessItem -Path $link
        Test-HarnessSamePath -Left $item.LinkTarget -Right $source

        Tells whether a link points at the expected source.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([bool])]
    param(
        [Parameter(Mandatory)]
        [string]$Left,

        [Parameter(Mandatory)]
        [string]$Right
    )

    try {
        $ErrorActionPreference = 'Stop'

        $comparison = if ($IsLinux) { [StringComparison]::Ordinal } else { [StringComparison]::OrdinalIgnoreCase }
        $leftFull = [IO.Path]::TrimEndingDirectorySeparator([IO.Path]::GetFullPath($Left))
        $rightFull = [IO.Path]::TrimEndingDirectorySeparator([IO.Path]::GetFullPath($Right))
        return [string]::Equals($leftFull, $rightFull, $comparison)
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Backup-HarnessItem {
    <#
    .SYNOPSIS
        Renames a file, folder or link beside itself as a timestamped backup.
    .DESCRIPTION
        The new name is <name>.harness-backup-<yyyyMMddHHmmss>, with a counter
        added if that name is taken. A link is renamed, not what it points at.
    .PARAMETER Path
        The full path of the item to back up.
    .PARAMETER WhatIf
        Shows what would happen if the command runs. The command is not run.
    .PARAMETER Confirm
        Prompts for confirmation before the command runs.
    .INPUTS
        None.
    .OUTPUTS
        System.String. The full path of the backup.
    .EXAMPLE
        Backup-HarnessItem -Path (Join-Path $HOME '.claude' 'CLAUDE.md')

        Moves a hand-made CLAUDE.md out of the way.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding(SupportsShouldProcess)]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)]
        [string]$Path
    )

    try {
        $ErrorActionPreference = 'Stop'

        if ((Get-HarnessItem -Path $Path).Kind -eq 'Missing') {
            throw "Backing up $Path failed: nothing is there."
        }

        $stamp = [DateTime]::Now.ToString('yyyyMMddHHmmss', [CultureInfo]::InvariantCulture)
        $backup = "$Path.harness-backup-$stamp"
        $counter = 1
        while ((Get-HarnessItem -Path $backup).Kind -ne 'Missing') {
            $backup = "$Path.harness-backup-$stamp-$counter"
            $counter++
        }

        if (-not $PSCmdlet.ShouldProcess($Path, "Back up to $([IO.Path]::GetFileName($backup))")) {
            return
        }

        Move-Item -LiteralPath $Path -Destination $backup -Confirm:$false
        return $backup
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function New-HarnessLink {
    <#
    .SYNOPSIS
        Makes a path a symbolic link to a source in the checkout.
    .DESCRIPTION
        Does nothing when the path already links to the source. Anything else
        at the path is backed up first (see Backup-HarnessItem), and put back
        if the link cannot be made. A folder source gets a directory link: a
        junction on Windows, which needs no Developer Mode, and a symbolic
        link elsewhere. A file source gets a symbolic link, which on Windows
        needs Developer Mode or an elevated shell.
    .PARAMETER Source
        The full path of the file or folder to link to.
    .PARAMETER Target
        The full path where the link goes.
    .PARAMETER WhatIf
        Shows what would happen if the command runs. The command is not run.
    .PARAMETER Confirm
        Prompts for confirmation before the command runs.
    .INPUTS
        None.
    .OUTPUTS
        System.Management.Automation.PSCustomObject. Source, Target, Action
        (Linked or AlreadyLinked) and Backup.
    .EXAMPLE
        $skills = Join-Path (Get-HarnessRoot) 'claude' 'skills'
        New-HarnessLink -Source $skills -Target $HOME/.claude/skills

        Links the skills folder into the home directory.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding(SupportsShouldProcess)]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory)]
        [string]$Source,

        [Parameter(Mandatory)]
        [string]$Target
    )

    try {
        $ErrorActionPreference = 'Stop'

        # Exists, not Get-HarnessItem: these follow a link, so a source that is itself a link still counts.
        if (-not ([IO.File]::Exists($Source) -or [IO.Directory]::Exists($Source))) {
            throw "Linking $Target failed: the source $Source does not exist."
        }

        $existing = Get-HarnessItem -Path $Target
        if ($existing.Kind -eq 'Link' -and (Test-HarnessSamePath -Left $existing.LinkTarget -Right $Source)) {
            return [PSCustomObject]@{
                Source = $Source
                Target = $Target
                Action = 'AlreadyLinked'
                Backup = $null
            }
        }

        $action = if ($existing.Kind -eq 'Missing') {
            "Create a link to $Source"
        }
        else {
            "Back up the existing $($existing.Kind.ToLowerInvariant()) and link to $Source"
        }

        if (-not $PSCmdlet.ShouldProcess($Target, $action)) {
            return
        }

        $parent = [IO.Path]::GetDirectoryName($Target)
        if (-not [IO.Directory]::Exists($parent)) {
            $null = New-Item -ItemType Directory -Path $parent -Force -Confirm:$false
        }

        $backup = $null
        if ($existing.Kind -ne 'Missing') {
            $backup = Backup-HarnessItem -Path $Target -Confirm:$false
        }

        $itemType = 'SymbolicLink'
        if ($IsWindows -and [IO.Directory]::Exists($Source)) {
            # A junction links a directory without Developer Mode; symlinks are kept for files and Linux.
            $itemType = 'Junction'
        }

        try {
            $null = New-Item -ItemType $itemType -Path $Target -Target $Source -Confirm:$false
        }
        catch {
            if ($backup) {
                Move-Item -LiteralPath $backup -Destination $Target -Confirm:$false
            }

            $hint = ''
            if ($IsWindows -and $_.Exception.Message -match 'privilege') {
                $hint = ' Turn on Developer Mode, or use an elevated shell.'
            }

            throw "Linking $Target failed: $($_.Exception.Message)$hint"
        }

        $created = Get-HarnessItem -Path $Target
        if ($created.Kind -ne 'Link' -or -not (Test-HarnessSamePath -Left $created.LinkTarget -Right $Source)) {
            throw "Linking $Target failed: the new link does not point at $Source."
        }

        return [PSCustomObject]@{
            Source = $Source
            Target = $Target
            Action = 'Linked'
            Backup = $backup
        }
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Merge-HarnessObject {
    <#
    .SYNOPSIS
        Returns a deep merge of two parsed JSON values.
    .DESCRIPTION
        Objects merge key by key, recursively. Arrays are joined: the base's
        items first, then the overlay's, each distinct item once. Anything
        else takes the overlay's value. Neither input is changed.
    .PARAMETER Base
        The value to start from, such as claude/settings.json.
    .PARAMETER Overlay
        The value laid over it, such as local/settings.json.
    .INPUTS
        None.
    .OUTPUTS
        System.Collections.Specialized.OrderedDictionary. The merged object.
    .EXAMPLE
        $base = Read-HarnessJson -Path /home/me/a.json
        $overlay = Read-HarnessJson -Path /home/me/b.json
        Merge-HarnessObject -Base $base -Overlay $overlay

        Returns a.json with b.json merged over it.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([System.Collections.Specialized.OrderedDictionary])]
    param(
        [Parameter(Mandatory)]
        [AllowNull()]
        [object]$Base,

        [Parameter(Mandatory)]
        [AllowNull()]
        [object]$Overlay
    )

    try {
        $ErrorActionPreference = 'Stop'

        return (Merge-HarnessValue -Base $Base -Overlay $Overlay)
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Expand-HarnessToken {
    <#
    .SYNOPSIS
        Returns a parsed JSON value with {{name}} tokens replaced in every
        string value.
    .DESCRIPTION
        Only string values are touched; dictionary keys are left as they are.
    .PARAMETER InputObject
        The parsed value. It is not changed.
    .PARAMETER Token
        Each token's name and the text that replaces it, such as
        @{ hooks = '/home/me/ai-harness/claude/hooks' }.
    .INPUTS
        None.
    .OUTPUTS
        System.Collections.Specialized.OrderedDictionary. The expanded copy.
    .EXAMPLE
        Expand-HarnessToken -InputObject $settings -Token @{ home = '/home/me' }

        Replaces {{home}} in every string value of the settings.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([System.Collections.Specialized.OrderedDictionary])]
    param(
        [Parameter(Mandatory)]
        [AllowNull()]
        [object]$InputObject,

        [Parameter(Mandatory)]
        [hashtable]$Token
    )

    try {
        $ErrorActionPreference = 'Stop'

        return (Expand-HarnessValue -Value $InputObject -Token $Token)
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Compare-HarnessObject {
    <#
    .SYNOPSIS
        Returns the differences between two parsed JSON values.
    .DESCRIPTION
        Objects are compared key by key. Arrays are compared as sets: an item
        only in the difference is Added, one only in the reference is Removed,
        and their order is ignored. Anything else that differs is Changed.
        Each record names the JSON path, such as permissions.allow.
    .PARAMETER Reference
        The value as it was, such as the sidecar the installer wrote.
    .PARAMETER Difference
        The value as it is now, such as the settings file.
    .INPUTS
        None.
    .OUTPUTS
        System.Management.Automation.PSCustomObject. Path, Change (Added,
        Removed or Changed), Value and Previous, one record per difference.
    .EXAMPLE
        Compare-HarnessObject -Reference $sidecar -Difference $settings

        Lists what changed in the settings since they were generated.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([PSCustomObject])]
    param(
        [Parameter(Mandatory)]
        [AllowNull()]
        [object]$Reference,

        [Parameter(Mandatory)]
        [AllowNull()]
        [object]$Difference
    )

    try {
        $ErrorActionPreference = 'Stop'

        $result = [List[object]]::new()
        Compare-HarnessValue -Reference $Reference -Difference $Difference -Path '' -Result $result
        foreach ($difference in $result) {
            $difference
        }
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

function Get-HarnessNewLine {
    <#
    .SYNOPSIS
        Returns the line ending a text already uses.
    .DESCRIPTION
        The first line ending found wins. A text with none gets the platform's
        own.
    .PARAMETER Text
        The text to look at.
    .INPUTS
        None.
    .OUTPUTS
        System.String. The line ending.
    .EXAMPLE
        $md = '/home/me/ai-harness/claude/CLAUDE.md'
        Get-HarnessNewLine -Text (Read-HarnessText -Path $md)

        Returns the line ending of the instructions source.
    .LINK
        https://github.com/TaffarelJr/ai-harness/blob/main/README.md
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)]
        [AllowEmptyString()]
        [string]$Text
    )

    try {
        $ErrorActionPreference = 'Stop'

        $match = [regex]::Match($Text, '\r?\n')
        if ($match.Success) {
            return $match.Value
        }

        return [Environment]::NewLine
    }
    catch {
        $PSCmdlet.ThrowTerminatingError(
            (ConvertTo-CommandError -ErrorRecord $_ -Command $MyInvocation.MyCommand.Name))
    }
}

